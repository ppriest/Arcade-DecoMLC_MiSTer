# Standalone synthesis check: the SH7604 at 84 MHz (sh7604_synth_top.sv).
# Run with `python scripts/synth_check.py`; read output_files/decomlc_synth_check.sta.summary.
set_global_assignment -name FAMILY "Cyclone V"
set_global_assignment -name DEVICE 5CSEBA6U23I7
set_global_assignment -name DEVICE_FILTER_PACKAGE UFBGA
set_global_assignment -name DEVICE_FILTER_PIN_COUNT 672
set_global_assignment -name DEVICE_FILTER_SPEED_GRADE 7
set_global_assignment -name TOP_LEVEL_ENTITY sh7604_synth_top
set_global_assignment -name PROJECT_OUTPUT_DIRECTORY output_files
set_global_assignment -name VERILOG_INPUT_VERSION SYSTEMVERILOG_2005
set_global_assignment -name SYSTEMVERILOG_FILE ../cpu/sh7604/SH_pkg.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../cpu/sh7604/SH7604_pkg.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../cpu/sh7604/SH_core_trace.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../cpu/sh7604/SH_core.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../cpu/sh7604/SH_mem.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../cpu/sh7604/SH_regfile.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../cpu/sh7604/SH7604_mem.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../cpu/sh7604/UBC.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../cpu/sh7604/SCI.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../cpu/sh7604/FRT.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../cpu/sh7604/DMAC.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../cpu/sh7604/WDT.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../cpu/sh7604/MSBY.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../cpu/sh7604/MULT.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../cpu/sh7604/DIVU.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../cpu/sh7604/INTC.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../cpu/sh7604/BSC.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../cpu/sh7604/CACHE.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../cpu/sh7604/SH7604.sv
set_global_assignment -name VERILOG_FILE ../cpu/jtsh7604_cps3_region.v
set_global_assignment -name SYSTEMVERILOG_FILE ../cpu/jtsh7604.sv
set_global_assignment -name SYSTEMVERILOG_FILE sh7604_synth_top.sv
set_global_assignment -name SDC_FILE decomlc_synth_check.sdc
set_global_assignment -name LAST_QUARTUS_VERSION "17.0.2 Lite Edition"
