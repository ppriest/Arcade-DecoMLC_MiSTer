# the 93C45 (rtl/jteeprom)
set_global_assignment -name VERILOG_FILE rtl/jteeprom/jt9346.v
# clk_sdram on a global clock: the fitter put it on a regional one covering a quarter of the die,
# which cannot clock the SDRAM pins' I/O registers outside it, so their registers landed in the
# fabric with untimed pin paths, and a release fit came up black (docs/LESSONS_LEARNED.md)
set_instance_assignment -name GLOBAL_SIGNAL "GLOBAL CLOCK" -to "emu:emu|pll:pll|pll_0002:pll_inst|altera_pll:altera_pll_i|outclk_wire[3]"
